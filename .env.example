# Required
API_KEY=change-me-please

# Optional / defaults
PORT=8787
BIND_ADDR=127.0.0.1
DATA_DIR=./data
DB_PATH=./data/cal.db
LOG_LEVEL=info
SYNC_INTERVAL_MS=300000
NODE_ENV=development

# OAuth encryption key: 32-byte base64 (44 chars)
# Example (do not use in prod): OAUTH_ENCRYPTION_KEY=YmFzZTY0LXNlY3JldC1iYXNlNjQtc2VjcmV0LXNlY3JldA==
OAUTH_ENCRYPTION_KEY=

# Google OAuth — TV/Limited Input client (used for device flow + token refresh)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default includes both Calendar (read-only) and Tasks (read/write).
# After changing scopes, re-run: yarn auth:google or yarn auth:google:loopback
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/tasks

# Google OAuth — Desktop client (required for Tasks scope via loopback flow)
# Create an "OAuth client ID" of type "Desktop app" in GCP Console.
# Run: yarn auth:google:loopback  (opens browser, works with Tasks scope)
GOOGLE_LOOPBACK_CLIENT_ID=
GOOGLE_LOOPBACK_CLIENT_SECRET=

# ICS bootstrap (comma-separated URLs)
ICS_URLS=
